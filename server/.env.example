PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/sentinelx
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Pin Scapy to the adapter which owns this IPv4 address. On this machine the
# connected Wi-Fi adapter owns 192.168.20.3; update this value if it changes.
SENTINELX_CAPTURE_IP=192.168.20.3

# Keep firewall actions non-destructive while validating detection.
SENTINELX_PREVENTION_MODE=test

# Detection thresholds. Authentication failures are submitted through
# POST /api/detection/auth-events by a service or log shipper.
SENTINELX_BRUTE_FORCE_THRESHOLD=20
SENTINELX_DDOS_THRESHOLD=1000

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/sentinelx
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Pin Scapy to the adapter which owns this IPv4 address. On this machine the
# connected Wi-Fi adapter owns 192.168.20.3; update this value if it changes.
SENTINELX_CAPTURE_IP=192.168.20.3

# Keep firewall actions non-destructive while validating detection.
# test   = simulate BLOCK_SIMULATED (default, safe)
# active = create real Windows Firewall rules (requires Administrator)
# Example rule: SentinelX-IDPS-BLOCK-192_168_1_100
SENTINELX_PREVENTION_MODE=test

# When mode=active, detection still waits for dashboard confirmation unless
# this is true. Manual Block IP always applies a real rule in active mode.
SENTINELX_PREVENTION_AUTO_BLOCK=false

# Optional never-block IPv4 list (comma-separated), in addition to local IPs.
# SENTINELX_PREVENTION_ALLOWLIST=192.168.20.1,192.168.20.3

# Detection thresholds. Authentication failures are submitted through
# POST /api/detection/auth-events by a service or log shipper.
SENTINELX_BRUTE_FORCE_THRESHOLD=20
SENTINELX_DDOS_THRESHOLD=1000
